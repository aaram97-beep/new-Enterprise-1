{
  "entities": {
    "Settings": {
      "title": "Settings",
      "description": "Global company configuration stored at /settings/main.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 80 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 20 },
        "taxRate": { "type": "number" },
        "expiryWarnDays": { "type": "number" },
        "logo": { "type": "string", "maxLength": 700000 },
        "lang": { "type": "string", "enum": ["en", "ar"] },
        "features": { "type": "object" },
        "trackBatchExpiry": { "type": "boolean" },
        "lotExpiryMode": { "type": "string", "enum": ["both", "lot", "expiry", "none"] },
        "showInOtherBranchStatus": { "type": "boolean" },
        "moneyDecimals": { "type": "integer" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "isBranchCompany": { "type": "boolean" },
        "directSaleMode": { "type": "boolean" },
        "workspaceInitialized": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "address", "phone", "currency", "taxRate", "expiryWarnDays", "logo", "lang", "features", "createdAt", "updatedAt"]
    },
    "BranchCounter": {
      "title": "BranchCounter",
      "description": "Per-branch sequential document numbering counters.",
      "type": "object",
      "properties": {
        "INV": { "type": "integer" },
        "DEL": { "type": "integer" },
        "RSL": { "type": "integer" },
        "RIN": { "type": "integer" },
        "INT": { "type": "integer" },
        "ARR": { "type": "integer" },
        "TRF": { "type": "integer" },
        "DSP": { "type": "integer" },
        "CHK": { "type": "integer" },
        "BRT": { "type": "integer" },
        "PAY": { "type": "integer" },
        "MTR": { "type": "integer" },
        "EXP": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["INV", "DEL", "RSL", "RIN", "INT", "ARR", "TRF", "DSP", "CHK", "BRT", "PAY", "MTR", "EXP", "createdAt", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "Employee profile, RBAC role, branch assignments, and granular permissions (never stores passwords).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "username": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "branchIds": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "deletedAt": { "type": ["number", "null"] },
        "perms": { "type": "object" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "sidebarCollapsed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "username", "role", "branchIds", "active", "perms", "createdAt", "updatedAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Warehouse or retail branch location.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "isMain": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "name", "address", "isMain", "createdAt", "updatedAt"]
    },
    "MoneyAccount": {
      "title": "MoneyAccount",
      "description": "Cashbox, bank account, or cheques-in-hand ledger account.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 160 },
        "type": { "type": "string", "enum": ["cashbox", "bank", "cheques"] },
        "branchId": { "type": ["string", "null"] },
        "opening": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type", "branchId", "opening", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer or supplier/provider account profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 80 },
        "address": { "type": "string", "maxLength": 300 },
        "openingBalance": { "type": "number" },
        "isProvider": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "address", "openingBalance", "isProvider", "createdAt", "updatedAt"]
    },
    "Item": {
      "title": "Item",
      "description": "Inventory catalog item definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 160 },
        "group": { "type": "string", "maxLength": 120 },
        "cost": { "type": "number" },
        "price": { "type": "number" },
        "reorder": { "type": "number" },
        "barcode": { "type": "string", "maxLength": 120 },
        "note": { "type": "string", "maxLength": 500 },
        "batch": { "type": "boolean" },
        "trackingMode": { "type": "string", "enum": ["global", "both", "lot", "expiry", "none"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sku", "name", "company", "group", "cost", "price", "reorder", "barcode", "note", "batch", "createdAt", "updatedAt"]
    },
    "StockBatch": {
      "title": "StockBatch",
      "description": "Live inventory batch quantity per item and branch.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "branchId": { "type": "string" },
        "batchNo": { "type": "string", "maxLength": 120 },
        "expiry": { "type": "string", "maxLength": 32 },
        "qty": { "type": "number" },
        "cost": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "itemId", "branchId", "batchNo", "expiry", "qty", "cost", "createdAt", "updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Customer sales invoice.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "branchId": { "type": "string" },
        "note": { "type": "string" },
        "lines": { "type": "array" },
        "orderDiscType": { "type": "string", "enum": ["pct", "amt"] },
        "orderDiscVal": { "type": "number" },
        "sub": { "type": "number" },
        "discAmt": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "customerId", "branchId", "lines", "orderDiscType", "orderDiscVal", "sub", "discAmt", "tax", "total", "createdAt", "updatedAt"]
    },
    "Delivery": {
      "title": "Delivery",
      "description": "Delivery slip linked to an invoice or return slip.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "invoiceId": { "type": ["string", "null"] },
        "returnSlipId": { "type": ["string", "null"] },
        "customerId": { "type": "string" },
        "branchId": { "type": "string" },
        "note": { "type": "string" },
        "lines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "customerId", "branchId", "lines", "createdAt", "updatedAt"]
    },
    "ReturnSlip": {
      "title": "ReturnSlip",
      "description": "Customer return slip bringing items into stock.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "branchId": { "type": "string" },
        "note": { "type": "string" },
        "returnInvoiceId": { "type": ["string", "null"] },
        "lines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "customerId", "branchId", "returnInvoiceId", "lines", "createdAt", "updatedAt"]
    },
    "ReturnInvoice": {
      "title": "ReturnInvoice",
      "description": "Credit note issued against a return slip.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "branchId": { "type": "string" },
        "returnSlipId": { "type": "string" },
        "note": { "type": "string" },
        "lines": { "type": "array" },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "customerId", "branchId", "returnSlipId", "lines", "total", "createdAt", "updatedAt"]
    },
    "Intake": {
      "title": "Intake",
      "description": "Supplier buying receipt.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "providerId": { "type": "string" },
        "branchId": { "type": "string" },
        "note": { "type": "string" },
        "total": { "type": "number" },
        "lines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "providerId", "branchId", "total", "lines", "createdAt", "updatedAt"]
    },
    "Arrival": {
      "title": "Arrival",
      "description": "Physical warehouse stock arrival note.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "intakeId": { "type": "string" },
        "branchId": { "type": "string" },
        "note": { "type": "string" },
        "lines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "intakeId", "branchId", "lines", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Cash, bank, or check payment entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "disc": { "type": "number" },
        "method": { "type": "string" },
        "note": { "type": "string" },
        "dir": { "type": "string", "enum": ["in", "out"] },
        "branchId": { "type": "string" },
        "accountId": { "type": ["string", "null"] },
        "allocs": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "customerId", "amount", "disc", "method", "dir", "branchId", "allocs", "createdAt", "updatedAt"]
    },
    "CheckDoc": {
      "title": "CheckDoc",
      "description": "Check in hand receivable instrument.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "customerId": { "type": "string" },
        "checkNo": { "type": "string" },
        "bank": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["received", "deposited", "cleared", "bounced", "overdue"] },
        "receivedDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "note": { "type": "string" },
        "payouts": { "type": "array" },
        "clearedAccountId": { "type": ["string", "null"] },
        "clearedDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "customerId", "checkNo", "bank", "amount", "status", "receivedDate", "dueDate", "payouts", "createdAt", "updatedAt"]
    },
    "Transfer": {
      "title": "Transfer",
      "description": "Inter-branch stock transfer order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "receivedDate": { "type": "string" },
        "fromBranchId": { "type": "string" },
        "toBranchId": { "type": "string" },
        "status": { "type": "string", "enum": ["transit", "completed", "cancelled"] },
        "note": { "type": "string" },
        "lines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "fromBranchId", "toBranchId", "status", "lines", "createdAt", "updatedAt"]
    },
    "Disposal": {
      "title": "Disposal",
      "description": "Damaged or expired inventory write-off request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "branchId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "loss": { "type": "number" },
        "note": { "type": "string" },
        "lines": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "branchId", "status", "lines", "createdAt", "updatedAt"]
    },
    "Barter": {
      "title": "Barter",
      "description": "Barter goods exchange transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "partnerId": { "type": "string" },
        "branchId": { "type": "string" },
        "note": { "type": "string" },
        "giveLines": { "type": "array" },
        "recvLines": { "type": "array" },
        "giveValue": { "type": "number" },
        "recvValue": { "type": "number" },
        "loss": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "partnerId", "branchId", "giveLines", "recvLines", "giveValue", "recvValue", "loss", "createdAt", "updatedAt"]
    },
    "StockAdjust": {
      "title": "StockAdjust",
      "description": "Append-only stock quantity adjustment record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "branchId": { "type": "string" },
        "itemId": { "type": "string" },
        "batchNo": { "type": "string" },
        "expiry": { "type": "string" },
        "qty": { "type": "number" },
        "cost": { "type": "number" },
        "reason": { "type": "string" },
        "user": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "branchId", "itemId", "qty", "cost", "reason", "createdAt", "updatedAt"]
    },
    "MoneyMove": {
      "title": "MoneyMove",
      "description": "Transfer between cashboxes and bank accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "acceptedDate": { "type": "string" },
        "fromAccountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["transit", "done", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "fromAccountId", "toAccountId", "amount", "status", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "accountId": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "no", "date", "category", "accountId", "amount", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only user activity audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ts": { "type": "number" },
        "user": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ts", "user", "action", "details", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/settings/{settingId}": { "schema": { "$ref": "#/entities/Settings" }, "description": "Global company settings singleton (/settings/main)." },
    "/counters/{branchId}": { "schema": { "$ref": "#/entities/BranchCounter" }, "description": "Per-branch sequential document numbering counters." },
    "/users/{uid}": { "schema": { "$ref": "#/entities/User" }, "description": "Employee roles, branch access, and granular permissions." },
    "/branches/{branchId}": { "schema": { "$ref": "#/entities/Branch" }, "description": "Company branches and warehouses." },
    "/accounts/{accountId}": { "schema": { "$ref": "#/entities/MoneyAccount" }, "description": "Cashboxes, bank accounts, and cheques account." },
    "/customers/{customerId}": { "schema": { "$ref": "#/entities/Customer" }, "description": "Customers and suppliers." },
    "/items/{itemId}": { "schema": { "$ref": "#/entities/Item" }, "description": "Inventory catalog items." },
    "/stocks/{stockId}": { "schema": { "$ref": "#/entities/StockBatch" }, "description": "Live stock batches per item and branch." },
    "/invoices/{invoiceId}": { "schema": { "$ref": "#/entities/Invoice" }, "description": "Sales invoices." },
    "/deliveries/{deliveryId}": { "schema": { "$ref": "#/entities/Delivery" }, "description": "Delivery slips." },
    "/returnSlips/{slipId}": { "schema": { "$ref": "#/entities/ReturnSlip" }, "description": "Customer return slips." },
    "/returnInvoices/{creditNoteId}": { "schema": { "$ref": "#/entities/ReturnInvoice" }, "description": "Return credit notes." },
    "/intakes/{intakeId}": { "schema": { "$ref": "#/entities/Intake" }, "description": "Supplier buying receipts." },
    "/arrivals/{arrivalId}": { "schema": { "$ref": "#/entities/Arrival" }, "description": "Goods arrival notes." },
    "/payments/{paymentId}": { "schema": { "$ref": "#/entities/Payment" }, "description": "Payment vouchers." },
    "/checks/{checkId}": { "schema": { "$ref": "#/entities/CheckDoc" }, "description": "Checks in hand." },
    "/transfers/{transferId}": { "schema": { "$ref": "#/entities/Transfer" }, "description": "Inter-branch stock transfers." },
    "/disposals/{disposalId}": { "schema": { "$ref": "#/entities/Disposal" }, "description": "Inventory write-offs and disposals." },
    "/barters/{barterId}": { "schema": { "$ref": "#/entities/Barter" }, "description": "Barter exchanges." },
    "/adjusts/{adjustId}": { "schema": { "$ref": "#/entities/StockAdjust" }, "description": "Inventory adjustment log." },
    "/moneyMoves/{moveId}": { "schema": { "$ref": "#/entities/MoneyMove" }, "description": "Account-to-account money transfers." },
    "/expenses/{expenseId}": { "schema": { "$ref": "#/entities/Expense" }, "description": "Operating expenses." },
    "/audit/{auditId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "System audit log entries." }
  }
}
